# OmniAgent OS - Environment Variables Example Template
# Copy this file to .env.local and fill in your keys. Never commit .env.local!

# Multi-Provider LLM Keys (Configure at least one or connect local Ollama/vLLM)
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
XAI_API_KEY=""

# Local Model Endpoints (Optional)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
VLLM_BASE_URL="http://127.0.0.1:8001/v1"
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# Network & Ports
OMNIAGENT_HOST="127.0.0.1"
OMNIAGENT_PORT=8000
OMNIAGENT_FRONTEND_PORT=3000

# Safety & Autonomous Limits
OMNIAGENT_MAX_STEPS=40
OMNIAGENT_APPROVAL_TIMEOUT=300
OMNIAGENT_SHELL_TIMEOUT=120
